From c010f86bc77aa9c53dfa1a81e6de4df21d169b35 Mon Sep 17 00:00:00 2001
From: Sven Wehrend <wehrend@users.noreply.github.com>
Date: Thu, 26 Nov 2026 19:14:16 +0100
Subject: [PATCH] language switcher: grey out languages without translation
 instead of jumping to home

Site override of hugo-book's docs/languages partial. On regular pages without
a translation the other language is shown disabled (not clickable) with a hint,
so the reader stays on the current page. Sections/taxonomies without a
counterpart still fall back to the other language's home page.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_018Me4hFnybPX5P4M4eKtaqK
---
 assets/_custom.scss                   |  7 ++++
 layouts/_partials/docs/languages.html | 58 +++++++++++++++++++++++++++
 2 files changed, 65 insertions(+)
 create mode 100644 layouts/_partials/docs/languages.html

diff --git a/assets/_custom.scss b/assets/_custom.scss
index 1822cbe..f58a5be 100644
--- a/assets/_custom.scss
+++ b/assets/_custom.scss
@@ -391,3 +391,10 @@ td.code pre {
   &.warning   { --admonition-color: #e8590c; }
   &.caution   { --admonition-color: #e03131; }
 }
+
+// Language switcher: language without translation for the current page
+.book-languages .book-languages-missing {
+  display: block;
+  opacity: 0.5;
+  cursor: not-allowed;
+}
diff --git a/layouts/_partials/docs/languages.html b/layouts/_partials/docs/languages.html
new file mode 100644
index 0000000..125ad3f
--- /dev/null
+++ b/layouts/_partials/docs/languages.html
@@ -0,0 +1,58 @@
+{{/*
+  Site override of hugo-book's language switcher.
+  - Translation exists       -> link to it (as before).
+  - Regular page, no translation -> language shown greyed out, not clickable,
+    so the reader stays on the current page instead of landing on the other
+    language's home page.
+  - Sections/taxonomies without counterpart -> fall back to that language's home.
+*/}}
+{{ $translations := dict }}
+{{ range .Translations }}
+  {{ $translations = merge $translations (dict .Language.Lang .) }}
+{{ end }}
+{{ $notTranslated := dict
+  "de" "Noch nicht auf Deutsch verfügbar"
+  "en" "Not yet available in English"
+}}
+
+<ul class="book-languages">
+  <li>
+    <input type="checkbox" id="languages" class="toggle" />
+    <label for="languages" class="flex">
+      <a role="button">
+        <img src="{{ partial "docs/icon" "translate" }}" class="book-icon" alt="{{ partial "docs/text/i18n" "Languages" }}" />
+        {{ $.Site.Language.Label }}
+      </a>
+      <img src="{{ partial "docs/icon" "chevron-right" }}" class="book-icon" alt="{{ partial "docs/text/i18n" "Expand" }}" />
+    </label>
+
+    <ul>
+      {{ range hugo.Sites }}
+        {{ $lang := .Language.Lang }}
+        {{ if ne $lang $.Language.Lang }}
+          {{ with index $translations $lang }}
+      <li>
+        <a href="{{ cond hugo.IsMultihost .Permalink .RelPermalink }}" class="flex flex-auto" hreflang="{{ $lang }}">
+          {{ .Language.Label }}
+        </a>
+      </li>
+          {{ else }}
+            {{ if $.IsPage }}
+      <li>
+        <span class="book-languages-missing" aria-disabled="true" title="{{ index $notTranslated $lang | default "Not translated" }}">
+          {{ .Language.Label }} <small>({{ index $notTranslated $lang | default "not translated" }})</small>
+        </span>
+      </li>
+            {{ else }}
+      <li>
+        <a href="{{ cond hugo.IsMultihost .Home.Permalink .Home.RelPermalink }}" class="flex flex-auto" hreflang="{{ $lang }}">
+          {{ .Language.Label }}
+        </a>
+      </li>
+            {{ end }}
+          {{ end }}
+        {{ end }}
+      {{ end }}
+    </ul>
+  </li>
+</ul>
-- 
